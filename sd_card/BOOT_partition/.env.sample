# BOOT 分区环境变量模板（复制为 .env 生效）
# 用途：控制 U-Boot PL 首屏与 orchestrator 启动时的可选 Wi-Fi 注入行为

# ===== 显示链路（U-Boot） =====
# 0=关闭（默认建议，用于隔离 USB/Wi-Fi 排查）
# 1/yes/on=开启 PL 首屏链路
PL_SPLASH_ENABLE=0

# 彩条停留秒数（开启 PL_SPLASH_ENABLE 时生效）
PL_COLORBAR_HOLD=2

# splash 停留秒数（开启 PL_SPLASH_ENABLE 且存在 splash.rgb565 时生效）
PL_SPLASH_HOLD=1

# ===== Wi-Fi 注入（Linux orchestrator） =====
# 0=关闭（默认，避免误把设备拉入 STA）
# 1=开启（仅在你明确需要通过 BOOT .env 下发 Wi-Fi 配网时打开）
WIFI_BOOT_FALLBACK_ENABLE=0
