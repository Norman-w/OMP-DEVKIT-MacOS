# BOOT 分区环境变量模板（复制为 .env 生效）
# 用途：控制 U-Boot 是否启用 PL 首屏链路（彩条 + splash）
#
# 使用方法：
# 1) 将本文件复制为 BOOT 分区根目录的 .env
# 2) 按需修改变量
# 3) 重启开发板

# 0=关闭（默认建议，用于隔离 USB/Wi-Fi 排查）
# 1/yes/on=开启 PL 首屏链路
PL_SPLASH_ENABLE=0

# 彩条停留秒数（开启 PL_SPLASH_ENABLE 时生效）
PL_COLORBAR_HOLD=2

# splash 停留秒数（开启 PL_SPLASH_ENABLE 且存在 splash.rgb565 时生效）
PL_SPLASH_HOLD=1
